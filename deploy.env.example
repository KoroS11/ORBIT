# ORBIT Production Environment Template
# Copy this file to deploy.env on your EC2 host:
#   cp deploy.env.example deploy.env
# NEVER commit deploy.env with real keys or secrets.

# Domain configuration for Caddy automatic HTTPS (e.g. your-subdomain.duckdns.org)
DOMAIN=your-subdomain.duckdns.org

# Allowed origins for CORS (comma-separated, typically matches your HTTPS domain)
ORBIT_ALLOWED_ORIGINS=https://your-subdomain.duckdns.org

# LLM provider: gemini | stub (deterministic, free) | anthropic | ollama
ORBIT_LLM=gemini

# Google Gemini provider settings (active when ORBIT_LLM=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
ORBIT_GEMINI_MODEL=gemini-3.1-flash-lite
ORBIT_GEMINI_TIMEOUT_S=60
ORBIT_GEMINI_THINKING_BUDGET=0
ORBIT_LLM_FALLBACK=1
ORBIT_GEMINI_LIVE=1 # production only; leave unset locally

# Anthropic provider settings (active when ORBIT_LLM=anthropic)
# ANTHROPIC_API_KEY=your-anthropic-key-here
# ORBIT_ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama provider settings (active when ORBIT_LLM=ollama)
# ORBIT_OLLAMA_URL=http://localhost:11434
# ORBIT_OLLAMA_MODEL=gemma4:e2b
# ORBIT_OLLAMA_TIMEOUT_S=180

# Pipeline tuning & thread limits for t3.small (2 vCPU)
ORBIT_ATTRIB_WINDOW_S=2.0
ORBIT_LOG_LEVEL=INFO
OMP_NUM_THREADS=2

# Persisted state directory for decision reviews (mounted to Docker volume)
ORBIT_STATE_DIR=/app/data/state
