# Copy to .env on the server (never commit .env).
DOMAIN=your-name.duckdns.org
ORBIT_ALLOWED_ORIGINS=https://your-name.duckdns.org
ORBIT_API_KEY=replace-with-long-random-string
ORBIT_RATE_LIMIT_PER_MIN=60
ORBIT_MAX_WS_CLIENTS=50

# LLM provider: stub (free, deterministic) | gemini | anthropic | ollama
ORBIT_LLM=stub
# For ORBIT_LLM=gemini:
# GEMINI_API_KEY=
# ORBIT_GEMINI_MODEL=<model id from your key's model list>
# For ORBIT_LLM=anthropic:
# ANTHROPIC_API_KEY=
